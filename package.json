{
  "name": "agentic-test-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "oxlint -A all --type-aware --type-check",
    "test": "pnpm -r --stream test",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test",
    "lint:no-target-coupling": "node scripts/check-no-target-coupling.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0"
}
